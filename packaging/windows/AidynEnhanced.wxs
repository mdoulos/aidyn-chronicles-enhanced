<!--
  The Windows installer (docs/systems/releases.md). tools/package.ps1 builds it with
  `wix build`, passing the version, the laid-out folder and the license as RTF:
    -d Version=N.0.0 -d AppDir=<folder> -d LicenseRtf=<License.rtf> -d Icon=<ace-icon.ico>

  Per-machine, into Program Files\Aidyn Chronicles Enhanced, with Start menu shortcuts for both apps. The
  UpgradeCode never changes: it is how a new release finds and replaces the old one.
  The installer never writes the player's data folder (%LOCALAPPDATA%\AidynEnhanced), so
  uninstalling leaves it alone.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Aidyn Chronicles Enhanced"
           Manufacturer="mdoulos"
           Version="$(var.Version)"
           UpgradeCode="95991CB0-DD4E-46CE-B922-DAD744DA9903"
           Scope="perMachine"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Aidyn Chronicles Enhanced is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AidynEnhanced.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AidynEnhanced.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mdoulos/aidyn-renewed" />

    <!-- One page with the license and Install. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Aidyn Chronicles Enhanced" />
    </StandardDirectory>

    <Feature Id="AidynEnhanced">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Everything laid out: the executables, the PCKs, the .NET data folders, LICENSE and README.md. -->
      <Files Include="$(var.AppDir)\**" />
      <!-- The shortcuts are in the all-users Start menu. Windows Installer's checks (ICE43,
           ICE57) want a shortcut's component kept by a per-user registry value, which this is. -->
      <Component Id="Shortcuts" Directory="ProgramMenuFolder">
        <Shortcut Id="GameShortcut" Name="Aidyn Chronicles Enhanced" Target="[INSTALLFOLDER]aidyn-enhanced.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="EditorShortcut" Name="Aidyn Chronicles Enhanced Editor" Target="[INSTALLFOLDER]aidyn-enhanced-editor.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\mdoulos\AidynEnhanced" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
