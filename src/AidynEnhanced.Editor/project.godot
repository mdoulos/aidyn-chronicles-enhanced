; Engine configuration file.

config_version=5

[application]

config/name="Aidyn Chronicles Enhanced Editor"
run/main_scene="res://Main.tscn"
config/version="0"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://splash.png"
boot_splash/stretch_mode=1

[dotnet]

project/assembly_name="AidynEnhanced.Editor"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

textures/vram_compression/import_etc2_astc=true
limits/global_shader_variables/buffer_size=1048576
