<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Explicit, or the Godot editor writes its own default (net8.0) into this file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AidynRenewed.Editor</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The editor reads plugins (ADR 0010). AidynRenewed.Rom is only for running the importer and reading checkpoints, which needs no ROM. -->
    <ProjectReference Include="..\AidynRenewed.Core\AidynRenewed.Core.csproj" />
    <ProjectReference Include="..\AidynRenewed.Plugins\AidynRenewed.Plugins.csproj" />
    <ProjectReference Include="..\AidynRenewed.Rom\AidynRenewed.Rom.csproj" />
    <!-- The runtime's views, so the editor plays actors and draws map sets as the game does (ADRs 0010, 0022). -->
    <ProjectReference Include="..\AidynRenewed.Views\AidynRenewed.Views.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AidynRenewed.Views" />
  </ItemGroup>

</Project>
