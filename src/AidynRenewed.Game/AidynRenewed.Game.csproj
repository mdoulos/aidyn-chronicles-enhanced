<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Explicit, or the Godot editor writes its own default (net8.0) into this file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AidynRenewed.Game</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin format and the rules core: the runtime never reads the ROM (ADR 0001), and the build enforces it. -->
    <ProjectReference Include="..\AidynRenewed.Core\AidynRenewed.Core.csproj" />
    <ProjectReference Include="..\AidynRenewed.Plugins\AidynRenewed.Plugins.csproj" />
    <!-- What the runtime draws with and shares with the editor (ADR 0022). -->
    <ProjectReference Include="..\AidynRenewed.Views\AidynRenewed.Views.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AidynRenewed.Views" />
  </ItemGroup>

</Project>
