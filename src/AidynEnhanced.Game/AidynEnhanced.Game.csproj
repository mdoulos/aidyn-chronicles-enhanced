<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Explicit, or the Godot editor writes its own default (net8.0) into this file. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AidynEnhanced.Game</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin format and the rules core: the runtime never reads the ROM (ADR 0001), and the build enforces it. -->
    <ProjectReference Include="..\AidynEnhanced.Core\AidynEnhanced.Core.csproj" />
    <ProjectReference Include="..\AidynEnhanced.Plugins\AidynEnhanced.Plugins.csproj" />
    <!-- What the runtime draws with and shares with the editor (ADR 0022). -->
    <ProjectReference Include="..\AidynEnhanced.Views\AidynEnhanced.Views.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AidynEnhanced.Views" />
  </ItemGroup>

</Project>
